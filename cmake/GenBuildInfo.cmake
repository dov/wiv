# Run at BUILD time (cmake -P) by the always-out-of-date wiv_buildinfo target.
# Writes ${HEADER_PATH} with the current git commit id/date, touching the file
# only when the contents change so just BuildInfo.cpp recompiles (and wiv
# relinks) when HEAD moves - nothing else rebuilds.
#   -DSOURCE_DIR=<repo> -DHEADER_PATH=<out.h> -DVERSION=<x.y.z>
set(COMMIT_ID unknown)
set(COMMIT_DATE unknown)
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} log -1 --format=%H
                  WORKING_DIRECTORY ${SOURCE_DIR}
                  OUTPUT_VARIABLE _id OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND ${GIT_EXECUTABLE} log -1 --format=%ci
                  WORKING_DIRECTORY ${SOURCE_DIR}
                  OUTPUT_VARIABLE _date OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(_id)
    set(COMMIT_ID ${_id})
    set(COMMIT_DATE ${_date})
  endif()
endif()

set(_contents "// Autogenerated by cmake/GenBuildInfo.cmake. Don't add to git!
#define WIV_VERSION \"${VERSION}\"
#define WIV_COMMIT_ID \"${COMMIT_ID}\"
#define WIV_COMMIT_DATE \"${COMMIT_DATE}\"
")
set(_old "")
if(EXISTS "${HEADER_PATH}")
  file(READ "${HEADER_PATH}" _old)
endif()
if(NOT _old STREQUAL _contents)
  file(WRITE "${HEADER_PATH}" "${_contents}")
endif()
