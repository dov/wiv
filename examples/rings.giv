# Two rings of translucent filled circles of varying size, orbiting one another,
# over a static background (everything before the first $frame).
# The red and green ring centres circle a common point while each ring also
# spins. Play with the animation bar (Space).
$fps 60

# static background: backdrop, orbit guides, crosshair
$balloon Backdrop
$color #f2f4f8
$outline_color #8892a6
$lw 2
$polygon
-85 -85
85 -85
85 85
-85 85
z

$balloon Orbit guides
$color #b8c0d0
$lw 1
$linedash 4 4
e 0 0 26 26 0
e 0 0 58 58 0

$color #b8c0d0
$lw 1
-85 0
85 0

$color #b8c0d0
$lw 1
0 -85
0 85

$frame
$color red/0.45
$marks fcircle
$scale_marks
$mark_size 10.00
